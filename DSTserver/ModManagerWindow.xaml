<Window x:Class="DSTserver.ModManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod 管理" Height="660" Width="1000"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：按编号下载 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="创意工坊 mod 编号" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtModId" Width="180" Margin="8,0,8,0" Padding="4,3"/>
            <Button x:Name="BtnDownload" Content="下载 Mod" Click="BtnDownload_Click" Padding="14,4"/>
            <Button x:Name="BtnRefresh" Content="刷新列表" Click="BtnRefresh_Click" Padding="14,4" Margin="8,0,0,0"/>
            <Button x:Name="BtnCheckUpdates" Content="检查全部 mod 更新" Click="BtnCheckUpdates_Click" Padding="14,4" Margin="8,0,0,0"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="#2563EB" TextWrapping="Wrap" MaxWidth="420"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：已安装 mod 列表 -->
            <GroupBox Header="已安装 Mod" Padding="6" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <CheckBox x:Name="ChkSelectAll" Content="全选"
                                  Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed"
                                  VerticalAlignment="Center"/>
                        <Button x:Name="BtnDeleteChecked" Content="删除选中"
                                Click="BtnDeleteChecked_Click" Padding="12,2" Margin="14,0,0,0"
                                Foreground="#B91C1C" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCheckedCount" Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Text="已勾选 0 个"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LstMods" SelectionChanged="LstMods_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                              Checked="ModSelChanged" Unchecked="ModSelChanged"
                                              ToolTip="勾选后参与批量删除" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Content="启用" Checked="ModCheckedChanged" Unchecked="ModCheckedChanged"
                                              VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,0,6,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Id}" Foreground="Gray"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- 右：配置编辑 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtModTitle" Text="未选择 mod" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlOptions"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnSaveCfg" Content="保存配置" Click="BtnSaveCfg_Click" Padding="16,6"/>
                    <Button x:Name="BtnDelete" Content="删除 Mod" Click="BtnDelete_Click" Padding="16,6"
                            Margin="8,0,0,0" Foreground="#B91C1C"/>
                    <TextBlock x:Name="TxtCfgHint" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
