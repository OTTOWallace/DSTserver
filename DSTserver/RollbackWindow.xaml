<Window x:Class="DSTserver.RollbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存档回档" Height="540" Width="640" MinHeight="420" MinWidth="540"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="时间范围" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbRange" Width="140" Margin="8,0,8,0" Padding="4,2"
                      SelectionChanged="CmbRange_SelectionChanged"/>
            <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" Padding="12,3"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,6">
            <CheckBox x:Name="ChkSelectAll" Content="全选"
                      Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed" VerticalAlignment="Center"/>
            <Button x:Name="BtnDeleteChecked" Content="删除选中备份" Click="BtnDeleteChecked_Click"
                    Padding="10,2" Margin="14,0,0,0" Foreground="#B91C1C" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtCheckedCount" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Margin="12,0,0,0" Text="已勾选 0 个"/>
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="LstBackups" Margin="0,0,0,8" SelectionChanged="LstBackups_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                  Checked="BackupSelChanged" Unchecked="BackupSelChanged"
                                  VerticalAlignment="Center" ToolTip="勾选后参与批量删除"/>
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding Slot}" Foreground="Gray" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Path}" Foreground="DarkGray" Margin="12,0,0,0"
                                   FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="BtnRestore" Content="回档到所选备份" Click="BtnRestore_Click" Padding="16,6"
                    FontSize="14" Foreground="#B45309"/>
            <Button x:Name="BtnClose" Content="关闭" Click="BtnClose_Click" Padding="16,6" Margin="8,0,0,0"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="Gray"
                       FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
