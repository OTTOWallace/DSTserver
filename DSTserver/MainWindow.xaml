<Window x:Class="DSTserver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:DSTserver.Services"
        Title="DSTserver · 饥荒联机版开服器 by大肥鱼deepseek"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：服务器设置与维护 -->
        <GroupBox Grid.Column="0" Header="服务器设置" Padding="10" Margin="0,0,10,0" FontSize="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="存档槽位" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="CmbSlot" Margin="8,0,0,0" Width="220" SelectionChanged="CmbSlot_SelectionChanged" Padding="4,2"/>
                </StackPanel>

                <TextBlock Text="服务器名称" FontSize="12"/>
                <TextBox x:Name="TxtClusterName" Margin="0,2,0,8" Padding="4,3"/>
                <TextBlock Text="服务器密码（留空 = 无密码）" FontSize="12"/>
                <TextBox x:Name="TxtPassword" Margin="0,2,0,8" Padding="4,3"/>
                <TextBlock Text="最大人数" FontSize="12"/>
                <TextBox x:Name="TxtMaxPlayers" Margin="0,2,0,8" Padding="4,3" Width="120" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="游戏模式" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="CmbGameMode" Margin="8,0,0,0" Width="180" Padding="4,2">
                        <ComboBoxItem Content="生存" Tag="survival"/>
                        <ComboBoxItem Content="荒野" Tag="wilderness"/>
                        <ComboBoxItem Content="无尽" Tag="endless"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ChkPvp" Content="PVP" Margin="0,0,0,4" FontSize="12"/>
                <CheckBox x:Name="ChkPause" Content="无人时暂停" IsChecked="True" Margin="0,0,0,4" FontSize="12"/>
                <CheckBox x:Name="ChkCaves" Content="启用洞穴" IsChecked="True" Margin="0,0,0,8" FontSize="12"/>

                <TextBlock Text="服务器令牌（Klei）" Margin="0,4,0,2" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtToken" Width="240" Padding="4,3"/>
                    <Button x:Name="BtnToken" Content="获取令牌" Click="BtnToken_Click" Padding="10,2" Margin="6,0,0,0"/>
                </StackPanel>
                <Button x:Name="BtnTokenPaste" Content="从剪贴板粘贴令牌" Click="BtnTokenPaste_Click" Padding="8,3" Margin="0,6,0,10" HorizontalAlignment="Left"/>

                <Separator/>
                <TextBlock x:Name="TxtServerPath" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,4" FontSize="11"/>
                <Button x:Name="BtnInstall" Content="安装 / 更新饥荒服务器" Click="BtnInstall_Click" Padding="10,5" FontSize="13"/>
                <TextBlock x:Name="TxtInstallStatus" TextWrapping="Wrap" Foreground="#2563EB" FontSize="11" Margin="0,4,0,0" MaxHeight="60"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnMods" Content="Mod 管理" Click="BtnMods_Click" Padding="14,6" FontSize="14" FontWeight="SemiBold"/>
                    <Button x:Name="BtnWorld" Content="世界设置" Click="BtnWorld_Click" Padding="14,6" Margin="8,0,0,0"/>
                </StackPanel>

                <Separator Margin="0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnStart" Content="启动服务器" Click="BtnStart_Click" Padding="16,6" FontWeight="SemiBold" FontSize="14"/>
                    <Button x:Name="BtnStop" Content="停止" Click="BtnStop_Click" Padding="16,6" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtServerState" Foreground="Gray" Margin="0,8,0,0" Text="状态：未运行" FontSize="12"/>

                <Separator Margin="0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnBackupNow" Content="立即备份" Click="BtnBackupNow_Click" Padding="10,5"/>
                    <Button x:Name="BtnRollback" Content="回档窗口" Click="BtnRollback_Click" Padding="10,5" Margin="8,0,0,0"/>
                    <Button x:Name="BtnModCheck" Content="检查 mod 更新" Click="BtnModCheck_Click" Padding="10,5" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtSchedule" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 右侧：日志 + 玩家控制台 -->
        <TabControl Grid.Column="1">
            <TabItem Header="服务器日志">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnLogClear" Content="清空日志" Click="BtnLogClear_Click" Padding="10,4"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             Background="#1E1E1E" Foreground="#DCDCDC"/>
                </Grid>
            </TabItem>

            <TabItem Header="玩家与控制台">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="在线玩家（每 5 秒刷新）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ListView Grid.Row="1" x:Name="LstPlayers" Height="130" Margin="0,0,0,8"
                              SelectionChanged="LstPlayers_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="玩家名称" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="ID" Width="280" DisplayMemberBinding="{Binding UserId}"/>
                                <GridViewColumn Header="NetID" Width="80" DisplayMemberBinding="{Binding NetId}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="给予物品" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbItem" Width="170" Margin="8,0,8,0" Padding="4,2"
                                  ItemsSource="{x:Static services:ItemCatalog.Items}"/>
                        <TextBlock Text="数量" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtCount" Width="60" Text="1" Margin="8,0,8,0" Padding="4,2"/>
                        <Button x:Name="BtnGive" Content="给予" Click="BtnGive_Click" Padding="14,3"/>
                        <TextBlock x:Name="TxtSelectedPlayer" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="Gray" FontSize="11" Text="未选中玩家"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="服务器控制台（输入 Lua 指令，回车或点发送）" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,4" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="TxtConsole" Width="560" Padding="4,3" KeyDown="TxtConsole_KeyDown"/>
                        <Button x:Name="BtnSend" Content="发送" Click="BtnSend_Click" Padding="14,3" Margin="8,0,0,0"/>
                        <Button x:Name="BtnSaveNow" Content="一键存档" Click="BtnSaveNow_Click" Padding="10,3" Margin="12,0,0,0"/>
                        <TextBox x:Name="TxtRollbackN" Width="36" Text="1" Padding="2,3" Margin="12,0,4,0"/>
                        <Button x:Name="BtnRollbackN" Content="服务器内回档(快照)" Click="BtnRollbackN_Click" Padding="10,3"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
