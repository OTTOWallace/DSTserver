<Window x:Class="DSTserver.DeleteSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除存档" Height="540" Width="600" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="勾选要删除世界存档的槽位。删除后该槽位的世界将重新生成（服务器名称/令牌/mod 等配置全部保留）。"
                   Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,6">
            <CheckBox x:Name="ChkSelectAll" Content="全选"
                      Checked="ChkSelectAll_Changed" Unchecked="ChkSelectAll_Changed" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtCheckedCount" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" Margin="14,0,0,0" Text="已勾选 0 个"/>
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="LstSlots" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                  Checked="SlotSelChanged" Unchecked="SlotSelChanged"
                                  IsEnabled="{Binding HasSave}"
                                  ToolTip="该槽位没有存档数据时不可选" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Slot, StringFormat=存档 {0}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,0,6,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="Gray"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <CheckBox Grid.Row="3" x:Name="ChkBackupFirst" Content="删除前自动备份一次（推荐）"
                  IsChecked="True" Margin="2,8,0,6"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="BtnDelete" Content="删除选中存档" Click="BtnDelete_Click" Padding="16,6"
                    Foreground="#B91C1C" FontSize="14"/>
            <Button x:Name="BtnClose" Content="关闭" Click="BtnClose_Click" Padding="16,6" Margin="8,0,0,0"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
